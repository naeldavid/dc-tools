# Add your Discord account tokens here
# Format: ACCOUNT=your_token_here or ACCOUNT-NAME=your_token_here
# You can add as many accounts as needed

ACCOUNT=your_account_token_1
ACCOUNT-2=your_account_token_2
ACCOUNT-3=your_account_token_3

# Delay settings (milliseconds)
# Min delay between account joins (helps avoid anti-bot detection)
MIN_JOIN_DELAY=2000
# Max delay between account joins
MAX_JOIN_DELAY=5000
